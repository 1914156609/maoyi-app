FROM node:22-alpine AS build
WORKDIR /src
COPY maoyi-admin/package*.json ./
RUN npm ci --no-fund --no-audit
COPY maoyi-admin/ ./
COPY maoyi-admin/.env.production.example ./.env.production
RUN npm run build:prod
FROM nginx:stable-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY maoyi-app/deploy/nginx-admin.conf /etc/nginx/conf.d/default.conf
