FROM node:22-alpine AS build
WORKDIR /src
COPY maoyi-app/package*.json ./
COPY maoyi-app/scripts/patch-jimp-file-type.mjs ./scripts/patch-jimp-file-type.mjs
RUN npm ci --no-fund --no-audit
COPY maoyi-app/src/ ./src/
COPY maoyi-app/index.html maoyi-app/vite.config.js ./
RUN npm run build
FROM nginx:stable-alpine
COPY --from=build /src/dist/build/h5 /usr/share/nginx/html
COPY maoyi-app/deploy/nginx-mini.conf /etc/nginx/conf.d/default.conf
