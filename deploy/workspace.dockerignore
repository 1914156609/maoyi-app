# The build context is the siblings' parent. Only required build sources enter it.
**
!.dockerignore
!maoyi-app/
maoyi-app/**
!maoyi-app/package.json
!maoyi-app/package-lock.json
!maoyi-app/index.html
!maoyi-app/vite.config.js
!maoyi-app/src/
!maoyi-app/src/**
!maoyi-app/scripts/
maoyi-app/scripts/**
!maoyi-app/scripts/patch-jimp-file-type.mjs
!maoyi-app/deploy/
maoyi-app/deploy/**
!maoyi-app/deploy/Dockerfile.*
!maoyi-app/deploy/nginx-*.conf
!maoyi-admin/
maoyi-admin/**
!maoyi-admin/package.json
!maoyi-admin/package-lock.json
!maoyi-admin/index.html
!maoyi-admin/vite.config.js
!maoyi-admin/src/
!maoyi-admin/src/**
!maoyi-admin/public/
!maoyi-admin/public/**
!maoyi-admin/vite/
!maoyi-admin/vite/**
!maoyi-backend/
maoyi-backend/**
!maoyi-backend/pom.xml
!maoyi-backend/ruoyi-*/
maoyi-backend/ruoyi-*/**
!maoyi-backend/ruoyi-*/pom.xml
!maoyi-backend/ruoyi-*/src/
!maoyi-backend/ruoyi-*/src/**

# Keep private data, generated files and VCS metadata excluded even under src/.
**/.git
**/.github
**/node_modules
**/target
**/dist
**/.secrets
**/.data
**/outputs
**/deliverables
**/.DS_Store
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.env
**/.env.*
# Vite's public production settings are required to compile the admin API base.
!maoyi-admin/.env.production.example
